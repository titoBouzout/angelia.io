{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,

    "module": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext", "WebWorker"],
    "moduleResolution": "NodeNext",

    "noEmit": true,

    /* "strictNullChecks": false,*/
    "noImplicitAny": false,

    /* @fails-components/webtransport ships .d.ts files with extensionless
     * relative imports that don't resolve under nodenext. Skip checking
     * library code — we only care about our own. */
    "skipLibCheck": true
  },
  "exclude": ["type-tests", "tests/demo"]
}
