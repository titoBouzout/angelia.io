{
	"name": "angelia.io",
	"version": "5.0.0",
	"description": "WebSockets Server and Client API for node.js and the browser, with rooms support.",
	"author": "@titoBouzout @boredofnames",
	"license": "GPL",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"client",
		"server",
		"shared",
		"types",
		"!server/*.d.ts"
	],
	"exports": {
		"./server": {
			"types": "./types/server/index.d.ts",
			"default": "./server/index.js"
		},
		"./client": {
			"types": "./types/client/index.d.ts",
			"default": "./client/index.js"
		},
		"./*": null
	},
	"devDependencies": {
		"@types/node": "^22.9.1",
		"@types/ws": "^8.18.2",
		"playwright": "^1.64.1",
		"pota": "^0.20.232",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"dev": "tsc --noEmit -w",
		"test": "node --test tests/*.test.js",
		"build:types": "node scripts/build-types.js",
		"prepack": "npm run build:types",
		"test:types": "tsc --noEmit && npm run build:types && tsc -p type-tests/",
		"demo": "node tests/demo/server.js",
		"bench:worker": "node bench/browser/run.js",
		"bench:server": "node bench/node-receive.js",
		"bench:fanout": "node bench/fanout.js"
	},
	"homepage": "https://github.com/titoBouzout/angelia.io",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/titoBouzout/angelia.io"
	},
	"keywords": [
		"Client",
		"Server",
		"Socket",
		"Sockets",
		"WebSocket",
		"WebSocketClient",
		"WebSocketServer",
		"events",
		"rooms api",
		"rooms",
		"socket api",
		"sockets api",
		"io",
		"ws"
	],
	"prettier": {
		"printWidth": 70,
		"useTabs": true,
		"semi": false,
		"singleQuote": true,
		"quoteProps": "as-needed",
		"jsxSingleQuote": false,
		"trailingComma": "all",
		"bracketSpacing": true,
		"bracketSameLine": false,
		"arrowParens": "avoid",
		"proseWrap": "never",
		"endOfLine": "lf",
		"singleAttributePerLine": true
	},
	"dependencies": {
		"ws": "^8.22.1"
	},
	"optionalDependencies": {
		"bufferutil": "^4.1.0"
	}
}
