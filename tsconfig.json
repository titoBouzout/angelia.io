{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,

    "module": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "NodeNext",

    "noEmit": true,

    /* "strictNullChecks": false,*/
    "noImplicitAny": false,

    "skipLibCheck": true
  },
  "exclude": ["type-tests", "tests/demo", "bench", "types"]
}
